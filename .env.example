# Copy to .env, fill in, chmod 600.
#
# Dashboard credentials (both required).
DASHBOARD_USER=miquel
# Generate with: python -m app.web.auth hash
DASHBOARD_PASSWORD_HASH=

# Telegram alerts. Without these the app still tracks and charts, and logs
# each digest to stdout instead of sending it.
TELEGRAM_BOT_TOKEN=
# Comma-separated chat ids: your phone and your wife's.
TELEGRAM_CHAT_IDS=

# The LAN address the NAS should publish the dashboard on, never 0.0.0.0.
LAN_BIND_IP=192.168.1.20
# Where the SQLite file and backups live. A NAS shared folder is the point.
DATA_DIR=/volume1/docker/parkhotelchecker/data

# Optional tuning.
# POLL_INTERVAL_SECONDS=60
# LOG_LEVEL=INFO
