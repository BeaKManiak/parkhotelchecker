# Copy to .env, fill in, then: chmod 600 .env
#
# Dashboard credentials (both required).
DASHBOARD_USER=admin
# Generate it with:
#   docker compose run --rm app python -m app.web.auth hash
# (or, locally: python -m app.web.auth hash)
#
# Keep the hash wrapped in SINGLE QUOTES. Compose treats an unquoted
# $2b$12$... as variable interpolation and truncates it; the app then starts
# but no password works. The app also rejects an incomplete hash at startup
# with the same explanation.
DASHBOARD_PASSWORD_HASH='<paste the hash here>'

# Telegram alerts (optional). Without these the app still tracks and charts,
# and logs each digest to stdout instead of sending it.
TELEGRAM_BOT_TOKEN=
# Comma-separated chat ids of everyone who should get alerts.
TELEGRAM_CHAT_IDS=

# The NAS LAN address the dashboard is published on. Never 0.0.0.0; the
# default (127.0.0.1) is intentionally unreachable from other devices.
LAN_BIND_IP=192.168.1.20
# Where SQLite and its backups live. Use one path consistently in commands.
DATA_DIR=/volume1/docker/parkhotelchecker/data

# Optional tuning.
# POLL_INTERVAL_SECONDS=60
# LOG_LEVEL=INFO
