# ---- Secrets ----
.env
.env.*
!.env.example
*.pem
*.key

# ---- Local data: SQLite, backups, anything the container writes ----
# The NAS keeps the real DB on a shared folder; this covers local dev runs.
data/
backups/
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.db-journal

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
.venv/
venv/
env/
ENV/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
nosetests.xml

# ---- Docker ----
# Compose override is machine-specific (LAN bind IP, host paths).
docker-compose.override.yml

# ---- Logs & runtime junk ----
*.log
logs/
pids/
*.pid
*.seed

# ---- macOS ----
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# ---- Editors ----
.idea/
.vscode/
!.vscode/extensions.json
*.swp
*.swo
*~

# ---- Keep test fixtures: they are the contract baseline, not generated output ----
!tests/fixtures/
!tests/fixtures/**
